{
  "name": "perfox-sdk",
  "version": "0.1.0",
  "description": "Official-style TypeScript SDK for the Perfox Platform API (Customers, Conversations, Knowledge Base, Credentials, MCP Servers, Analytics, Calls, Billing, Outbound, Messages).",
  "license": "UNLICENSED",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=18.17"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "keywords": [
    "perfox",
    "sdk",
    "api",
    "typescript",
    "conversational-ai"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "spec:types": "openapi-typescript spec/openapi.json -o test/generated/openapi.d.ts",
    "spec:inventory": "node scripts/generate-inventory.mjs",
    "spec:fetch": "node scripts/fetch-spec.mjs",
    "lint:package": "publint && attw --pack .",
    "pack:check": "npm pack --dry-run",
    "validate": "npm run typecheck && npm test && npm run build && npm run lint:package && npm run pack:check",
    "prepublishOnly": "npm run validate"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@types/node": "^22.20.5",
    "ajv": "^8.20.0",
    "openapi-typescript": "^7.13.0",
    "publint": "^0.3.25",
    "tsup": "^8.5.1",
    "typescript": "~5.9",
    "vitest": "^5.0.3"
  }
}
